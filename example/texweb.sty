% texweb.sty: texweb's commands for the PDF version.
% Load it with \usepackage{texweb} (copy it next to your .tex, or put it in TEXINPUTS).
%
%   \begin{widget}{name}[options]
%     the figure for the PDF (a tikzpicture, an \includegraphics, ...)
%   \end{widget}
%
% In the PDF the name and the options are ignored and the figure is printed.
% The figure is mandatory: when it is missing, LaTeX issues a warning and prints a red box
% in its place (texweb check and texweb build report it as an error).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texweb}[2026/10/28 texweb: interactive figures in the web version]
\RequirePackage{xcolor}

\NewDocumentEnvironment{widget}{m O{} +b}{%
  \IfBlankTF{#3}{%
    \PackageWarning{texweb}{Widget '#1' has no figure for the PDF.\MessageBreak
      Put it between \protect\begin{widget} and \protect\end{widget}}%
    \begin{center}
    \fcolorbox{red!70!black}{red!5}{\parbox{0.8\linewidth}{\centering\sffamily\small
      \textcolor{red!70!black}{\textbf{Missing figure}}\\
      widget \texttt{#1} has no figure for the PDF}}%
    \end{center}%
  }{#3}%
}{}
